{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: gcc.exe build active file",
			"command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
			"args": [
   			 "-g",
   			 "${file}",
   			 "-o",
   			 "${fileDirname}\\${fileBasenameNoExtension}.exe",
   			 "-lsfml-graphics",
   			 "-lsfml-window",
   			 "-lsfml-system"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: C:\\msys64\\ucrt64\\bin\\gcc.exe"
		}
	]
}